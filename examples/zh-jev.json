{
  "language": "zh",
  "namespace": "chinese_demo",
  "data_dir": ".data/zh",
  "embedding": {
    "dimension": 1024,
    "service": {
      "base_url": "http://127.0.0.1:8081/v1",
      "model": "BAAI/bge-m3",
      "key_env": "VGRAG_EMBEDDING_KEY"
    }
  },
  "models": {
    "default": {
      "base_url": "http://127.0.0.1:8080/v1",
      "model": "deepseek-ai/DeepSeek-V4.1-Flash",
      "key_env": "VGRAG_CHAT_KEY"
    }
  },
  "query": {
    "candidate_limit": 100,
    "per_channel": 30,
    "max_repairs": 2,
    "context_budget": 8000,
    "retrieval_mode": "two-stage",
    "profile": "zh_coverage_jev_v2"
  },
  "splitter": {
    "target": 384,
    "maximum": 512
  },
  "reranker": {
    "provider": "jev",
    "model": "jev-1.13.0",
    "key_env": "TYPESAFE_API_KEY",
    "base_url": "https://api.typesafe.ai/v1",
    "timeout": 60,
    "max_concurrency": 3,
    "service": "typesafe"
  },
  "milvus": {
    "uri": "http://127.0.0.1:19530",
    "token_env": "VGRAG_MILVUS_TOKEN"
  }
}
