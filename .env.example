# Fill locally; no real credentials. Load into your shell or use CLI --env-file.
VGRAG_CHAT_KEY=
VGRAG_EMBEDDING_KEY=
# Jev API setup (2026-11-12)
# 在下一行等号后填写 Typesafe 官方密钥；留空时不要启动 Jev 评测。
# 官方申请入口：https://console.typesafe.ai/settings/keys
# 充值：控制台 Settings -> Billing。
# 当前中文接入配置：examples/zh-jev.json（模型 jev-1.13.0）。
# API 地址和模型由 JSON 配置读取，不是由本 .env 文件切换。
# 本次仅复测原 20 题；冻结 BGE-small 索引，不能直接用示例的 BGE-M3 配置替换。
# 原回答/评分模型继续沿用现有配置；此密钥仅供 Jev 使用。
TYPESAFE_API_KEY=
OPENAI_API_KEY=
VGRAG_MILVUS_TOKEN=
# Shared Standalone endpoint for Chinese/English. Overrides JSON profile endpoints.
VGRAG_MILVUS_URI=http://127.0.0.1:19530
# Live integration tests only (no paid model calls):
# VGRAG_TEST_MILVUS_URI=http://127.0.0.1:19530

# JevHub 独立网关密钥：https://api.jevgo.cn；选择 service=jevhub 时使用。
JEVHUB_API_KEY=
